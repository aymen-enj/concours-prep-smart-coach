    "y_axes": [
      {
        "id": "left",
        "orientation": "left",
        "label": "Concentration (mmol.L$^{-1}$)",
        "unit": "\\mathrm{mmol.L^{-1}}",
        "domain": [0, 24],
        "ticks": [0, 4, 8, 12, 16, 20, 24]
      },
      {
        "id": "right",
        "orientation": "right",
        "label": "Concentration (mmol.L$^{-1}$)",
        "unit": "\\mathrm{mmol.L^{-1}}",
        "domain": [0, 12],
        "ticks": [0, 2, 4, 6, 8, 10, 12],
        "stroke": "#ffc658"
      }
    ],
    "legend": true,
    "grid": true,
    "annotations": []
  },
